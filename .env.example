# Backend
PORT=4000
DATABASE_URL=postgres://skipper:skipper@localhost:5432/skipper
# Connexion des utilisateurs (Google OAuth, console Google Cloud : identifiant « application Web »,
# URI de redirection autorisée = API_URL + /auth/google/callback). Sans ces deux valeurs, pas de bouton Google.
# Le même client sert à relier un compte Google à un projet (Gmail, Drive) : activer les API Gmail et Drive dans le projet Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Connexion Microsoft (Entra ID → Inscriptions d'applications, plateforme « Web », URI de redirection
# API_URL + /auth/microsoft/callback, un secret client). MICROSOFT_TENANT : common (défaut, comptes personnels et
# professionnels), organizations, consumers, ou l'identifiant d'un annuaire (seuls ses comptes se connectent alors).
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT=common
# Connexion GitHub (Settings → Developer settings → OAuth Apps, callback API_URL + /auth/github/callback). OAuth App
# distincte de GITHUB_CLIENT_ID (connexion des comptes git par code).
# GITHUB_LOGIN_CLIENT_ID=
# GITHUB_LOGIN_CLIENT_SECRET=
# Connexion par e-mail et mot de passe : active par défaut ; off pour la désactiver. « Mot de passe oublié » demande un
# l'envoi des e-mails (Brevo, ci-dessous ou Paramètres › Serveur) ; sans lui, un administrateur crée les liens depuis la
# page Utilisateurs.
# PASSWORD_LOGIN=on
# Envoi des e-mails (mot de passe oublié, invitations, canaux e-mail) par l'API Brevo : clé d'API (SMTP & API › Clés
# API) et expéditeur validé dans Brevo. L'emportent sur le réglage de Paramètres › Serveur.
# BREVO_API_KEY=
# MAIL_FROM=Skipper <skipper@toolso.io>
# URL publique du front (redirection après connexion, origine autorisée en CORS) et de l'API (callback OAuth,
# cookies Secure en https). En production les deux sont identiques (nginx sert le front et proxifie l'API).
# APP_URL=http://localhost:5173
# API_URL=http://localhost:4000
# Aperçus des branches (serveur de dev de chaque work session) : `*` = nom de l'aperçu. En local, *.localhost
# résout vers la machine dans Chrome et Firefox. Vide : aperçus désactivés.
# PREVIEW_URL=http://*.localhost:4000
# Optionnel : binaire Claude Code du serveur pour les commandes d'authentification du compte (sinon celui du SDK).
# Les sessions, elles, utilisent toujours le CLI de l'image Docker du projet.
# CLAUDE_BIN=/usr/local/bin/claude
# Optionnel : clé (64 caractères hexadécimaux, `openssl rand -hex 32`) qui chiffre les secrets du coffre
# (dont les jetons applicatifs : Claude, GitHub, fournisseurs OpenCode, LiteLLM, Langfuse). À défaut, une clé
# est générée dans WORKSPACES_ROOT/.secret-key.
# SKIPPER_SECRET_KEY=
# Dossier commun des workspaces : un sous-dossier par projet (défaut : ~/skipper-workspaces)
# WORKSPACES_ROOT=/chemin/vers/workspaces
# Niveau minimal du journal du backend : debug, info (défaut), warn ou error. Une ligne par message
# (horodatage ISO, niveau, [module]) ; info et debug sur stdout, warn et error sur stderr.
# LOG_LEVEL=info
# Horodatage des lignes du journal : auto (défaut : omis sous pm2 ou journald, qui datent déjà chaque
# ligne), on ou off.
# LOG_TIMESTAMP=auto

# Optionnel : identifiant (client id) d'une OAuth App GitHub à vous (device flow activé) pour la connexion
# GitHub par code depuis Paramètres → GitHub. À défaut, l'identifiant public du CLI GitHub est utilisé ;
# `none` désactive la connexion par code (il reste les jetons personnels déposés dans le coffre).
# GITHUB_CLIENT_ID=

# Optionnel : connexion GitLab par code (Paramètres → GitLab) : identifiant d'une application OAuth de l'instance
# (portées api, read_repository, write_repository ; GitLab 17.2+). Sans elle, seuls les jetons personnels du coffre.
# GITLAB_URL : instance (gitlab.com par défaut) ; GITLAB_CLIENT_SECRET : seulement pour une application confidentielle.
# GITLAB_CLIENT_ID=
# GITLAB_URL=https://gitlab.com
# GITLAB_CLIENT_SECRET=

# Conteneurs des projets (Docker obligatoire : toute session, terminal ou commande y tourne) : image et limites par défaut.
# SKIPPER_RUNNER_IMAGE=skipper-runner:latest
# SKIPPER_RUNNER_MEMORY=1g
# Plafond CPU (--cpus) ; vide ou absent : aucun plafond, les cœurs du serveur sont partagés équitablement entre conteneurs.
# SKIPPER_RUNNER_CPUS=

# Frontend (préfixe VITE_ obligatoire)
# Optionnel : URL de l'API (défaut : même hôte que le front, port 4000)
# VITE_GRAPHQL_URL=http://localhost:4000/graphql
